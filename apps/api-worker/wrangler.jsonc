{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reqbug-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",

  "durable_objects": {
    "bindings": [
      {
        "name": "INBOXES",
        "class_name": "ReqBugInbox"
      }
    ]
  },

  "exports": {
    "ReqBugInbox": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}